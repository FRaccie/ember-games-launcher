# /etc/ember-logs.env, mode 0600, owner root. Not in git.
EMBER_LOGS_LISTEN=127.0.0.1:8790
EMBER_LOGS_DIR=/var/lib/ember-logs
EMBER_LOGS_PUBLIC=https://logs.fraccie.be:8443
EMBER_LOGS_BUDGET_GB=15
# nginx sets X-Forwarded-For to the client's address.
EMBER_LOGS_TRUST_PROXY=1
# openssl rand -hex 32
EMBER_LOGS_KEY=
# The #launcher-logs channel's webhook; empty = no messages.
EMBER_LOGS_WEBHOOK=
