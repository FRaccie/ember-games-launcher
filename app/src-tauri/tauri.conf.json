{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ember Games Launcher",
  "version": "0.1.0",
  "identifier": "link.embernetplay.games-launcher",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Ember Games Launcher", "width": 1280, "height": 800, "minWidth": 1024, "minHeight": 640, "resizable": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "category": "Game",
    "shortDescription": "Install, update and start the Ember netplay mods"
  }
}
